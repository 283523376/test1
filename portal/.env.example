# Client-side base URLs (used in the browser — reachable from the host machine).
NEXT_PUBLIC_MODEL_API_URL=http://localhost:8000
NEXT_PUBLIC_MARKET_API_URL=http://localhost:8080

# Server-side base URLs (used by React Server Components — service names in Docker).
MODEL_API_URL=http://localhost:8000
MARKET_API_URL=http://localhost:8080
